DATABASE_URL=postgres://expense:expense@127.0.0.1:5434/expense_agent
ANTHROPIC_API_KEY=sk-ant-...
# Model used for receipt extraction (compare models with `npm run extract -- --model ...`)
EXTRACT_MODEL=claude-opus-5-5
# Model for the reviewer agent
REVIEW_MODEL=claude-opus-5-5
# Run the job worker inside the Next.js server (dev and single-instance deploys)
EMBEDDED_WORKER=1
